generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum DeviceStatus {
  DISPONIVEL
  RESERVADO
  VENDIDO
}

enum DeviceCondition {
  NOVO
  SEMINOVO
  USADO
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  OUTRO
}

model Device {
  id            String          @id @default(uuid()) @db.Uuid
  brand         String          @db.VarChar(80)
  model         String          @db.VarChar(120)
  storage       String          @db.VarChar(30)
  color         String          @db.VarChar(50)
  imei          String          @unique @db.VarChar(15)
  batteryHealth Int?
  condition     DeviceCondition
  purchasePrice Decimal         @db.Decimal(12, 2)
  salePrice     Decimal         @db.Decimal(12, 2)
  supplier      String?         @db.VarChar(160)
  entryDate     DateTime        @db.Date
  status        DeviceStatus    @default(DISPONIVEL)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sale Sale?

  @@index([status])
  @@index([entryDate])
  @@map("devices")
}

model Sale {
  id            String        @id @default(uuid()) @db.Uuid
  deviceId      String        @unique @db.Uuid
  deviceBrand   String        @db.VarChar(80)
  deviceModel   String        @db.VarChar(120)
  deviceImei    String        @db.VarChar(15)
  purchasePrice Decimal       @db.Decimal(12, 2)
  salePrice     Decimal       @db.Decimal(12, 2)
  customerName  String        @db.VarChar(160)
  customerPhone String?       @db.VarChar(30)
  paymentMethod PaymentMethod
  soldAt        DateTime      @db.Date
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  device Device @relation(fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([soldAt])
  @@index([customerName])
  @@map("sales")
}
