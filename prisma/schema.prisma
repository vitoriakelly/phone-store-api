generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  MASTER
  FUNCIONARIO
}

enum DeviceStatus {
  PENDENTE_INFORMACOES
  DISPONIVEL
  RESERVADO
  VENDIDO
}

enum DeviceCondition {
  NOVO
  SEMINOVO
  USADO
}

enum PaymentMethod {
  PIX
  DINHEIRO
  CARTAO_CREDITO
  CARTAO_DEBITO
  TRANSFERENCIA
  TROCA_DISPOSITIVO
  OUTRO
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  name         String    @db.VarChar(160)
  email        String    @unique @db.VarChar(160)
  passwordHash String    @db.VarChar(255)
  role         UserRole  @default(FUNCIONARIO)
  active       Boolean   @default(true)

  tokenVersion Int       @default(0)

  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([role])
  @@index([active])
  @@map("users")
}

model Device {
  id            String          @id @default(uuid()) @db.Uuid
  brand         String          @db.VarChar(80)
  model         String          @db.VarChar(120)
  storage       String          @db.VarChar(30)
  color         String?         @db.VarChar(50)
  imei          String?         @unique @db.VarChar(15)
  batteryHealth Int?
  condition     DeviceCondition
  purchasePrice Decimal         @db.Decimal(12, 2)
  salePrice     Decimal?        @db.Decimal(12, 2)
  supplier      String?         @db.VarChar(160)
  entryDate     DateTime        @db.Date
  status        DeviceStatus    @default(DISPONIVEL)
  notes         String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  sale        Sale? @relation("SoldDevice")
  tradeInSale Sale? @relation("TradeInDevice")

  @@index([status])
  @@index([entryDate])
  @@map("devices")
}

model Sale {
  id              String  @id @default(uuid()) @db.Uuid
  deviceId        String  @unique @db.Uuid
  tradeInDeviceId String? @unique @db.Uuid

  deviceBrand String @db.VarChar(80)
  deviceModel String @db.VarChar(120)
  deviceImei  String @db.VarChar(15)

  purchasePrice Decimal @db.Decimal(12, 2)
  salePrice     Decimal @db.Decimal(12, 2)

  customerName  String  @db.VarChar(160)
  customerPhone String? @db.VarChar(30)

  customerZipCode       String? @db.VarChar(9)
  customerStreet        String? @db.VarChar(180)
  customerNeighborhood  String? @db.VarChar(120)
  customerCity          String? @db.VarChar(120)
  customerAddressNumber String? @db.VarChar(30)
  customerSocialNetwork String? @db.VarChar(160)

  // Campo legado mantido temporariamente.
  paymentMethod PaymentMethod

  soldAt DateTime @db.Date
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  device        Device        @relation("SoldDevice", fields: [deviceId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  tradeInDevice Device?       @relation("TradeInDevice", fields: [tradeInDeviceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  payments      SalePayment[]

  @@index([soldAt])
  @@index([customerName])
  @@index([paymentMethod])
  @@map("sales")
}

model SalePayment {
  id           String        @id @default(uuid()) @db.Uuid
  saleId       String        @db.Uuid
  method       PaymentMethod
  amount       Decimal       @db.Decimal(12, 2)
  installments Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sale Sale @relation(fields: [saleId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([saleId])
  @@index([method])
  @@map("sale_payments")
}
